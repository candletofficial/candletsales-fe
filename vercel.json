{
  "rewrites": [
    {
      "source": "/d/:token",
      "destination": "/api/tracking-preview?token=:token&route=d"
    },
    {
      "source": "/t/:token",
      "destination": "/api/tracking-preview?token=:token&route=t"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
